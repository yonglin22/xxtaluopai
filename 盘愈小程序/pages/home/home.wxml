<scroll-view scroll-y class="page home">

  <view class="mh">
    <view class="hero-eyebrow">pán yù · self exploration</view>
    <view class="mh-hi serif">你好，{{nick}}</view>
    <view class="mh-tip">专注自我探索与情绪疏导的心理陪伴工具</view>
  </view>

  <!-- 今日牌 -->
  <view class="glass today" bindtap="goAsk">
    <view class="today-l">
      <view class="today-ey">TODAY · 今日牌</view>
      <view class="today-nm serif">{{todayCard}} · {{todayPos}}</view>
      <view class="today-d">今日运势已生成 · 点开抽一张 →</view>
    </view>
    <view class="today-orb">◔</view>
  </view>

  <!-- 命理 · 深度盘 -->
  <view class="section-h">命 理 · 深 度 盘</view>
  <scroll-view scroll-x class="fate-row" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{fates}}" wx:key="key" class="fate-slide" data-k="{{item.key}}" bindtap="onFate">
      <view class="poster fate-card">
        <view class="fate-top">
          <text class="poster-en">{{item.en}}</text>
          <view class="poster-seal">{{item.seal}}</view>
        </view>
        <view class="fate-body">
          <view class="poster-title serif">{{item.title}}</view>
          <view class="fate-rule"></view>
          <view class="poster-sub">{{item.sub}}</view>
        </view>
        <view class="fate-cta"><text>{{item.cta}}</text><text class="ar"> →</text></view>
      </view>
    </view>
  </scroll-view>

  <!-- DIY 命理选品 -->
  <view class="section-h">命 理 · 选 品</view>
  <view class="poster diy" bindtap="goShop">
    <view class="fate-top">
      <text class="poster-en">STONE LAB · 命理选品</text>
      <view class="poster-seal">串</view>
    </view>
    <view class="diy-body">
      <view class="diy-cv">📿</view>
      <view class="diy-tx">
        <view class="poster-title serif" style="font-size:36rpx">DIY 命理选品 · 心元石验室</view>
        <view class="poster-sub">按你的八字五行 + 此刻议题，为你预排一串专属珠串 · 可自由增减、调色、成串</view>
        <view class="diy-price">为你预排 · 可自由定制</view>
      </view>
    </view>
    <view class="btn btn-gold diy-btn">✦ 进工作室 · 开始定制 →</view>
  </view>

  <!-- 情绪陪伴 -->
  <view class="section-h">情 绪 陪 伴 · 有 我 在</view>
  <view wx:for="{{moods}}" wx:key="key" class="exrow" data-k="{{item.key}}" bindtap="onMood">
    <view class="ex-main">
      <view class="ex-t">{{item.t}}</view>
      <view class="ex-d">{{item.d}}</view>
    </view>
    <view class="ex-chev">›</view>
  </view>

  <view class="disclaimer">每日一签仅供自我觉察与提点，不构成确定性预测。</view>
</scroll-view>
