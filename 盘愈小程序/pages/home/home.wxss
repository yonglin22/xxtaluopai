.home { padding-top: 20rpx; }
.mh { padding: 24rpx 0 10rpx; text-align: center; }
.mh-hi { font-size: 40rpx; color: var(--ink); margin-top: 10rpx; }
.mh-tip { font-size: 22rpx; color: var(--ink-faint); margin-top: 10rpx; }

/* 今日牌 */
.today { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 30rpx; margin-top: 18rpx; }
.today-l { flex: 1; }
.today-ey { font-size: 20rpx; letter-spacing: .2em; color: var(--ink-faint); }
.today-nm { font-size: 34rpx; color: var(--ink); font-weight: 700; margin-top: 8rpx; }
.today-d { font-size: 22rpx; color: var(--ink-faint); margin-top: 8rpx; }
.today-orb { font-size: 64rpx; color: var(--amber); opacity: .8; }

/* 命理·深度盘 横滑 */
.fate-row { white-space: nowrap; margin: 0 -30rpx; padding: 4rpx 30rpx 10rpx; }
.fate-slide { display: inline-block; width: 78%; margin-right: 22rpx; vertical-align: top; }
.fate-card { height: 380rpx; display: flex; flex-direction: column; }
.fate-top { display: flex; align-items: center; justify-content: space-between; }
.fate-body { margin-top: auto; }
.fate-rule { width: 52rpx; height: 4rpx; border-radius: 4rpx; background: linear-gradient(90deg,#C9A24E,rgba(201,162,78,0)); margin: 18rpx 0 16rpx; }
.poster-title.serif { white-space: pre-line; line-height: 1.3; }
.fate-cta { display: inline-flex; align-items: center; align-self: flex-start; margin-top: 24rpx; padding: 14rpx 28rpx; border-radius: 30rpx; background: rgba(201,162,78,.12); border: 1rpx solid rgba(201,162,78,.44); color: var(--gold-deep); font-size: 24rpx; font-weight: 600; }
.fate-cta .ar { margin-left: 6rpx; }

/* DIY */
.diy { margin-top: 6rpx; }
.diy-body { display: flex; gap: 26rpx; align-items: center; margin-top: 22rpx; }
.diy-cv { flex: none; width: 168rpx; height: 168rpx; border-radius: 30rpx; background: radial-gradient(120% 120% at 50% 35%, #faf4e8, #efe6d3); border: 1rpx solid rgba(201,162,78,.3); display: flex; align-items: center; justify-content: center; font-size: 84rpx; }
.diy-tx { flex: 1; }
.diy-price { font-size: 24rpx; color: var(--gold-deep); font-weight: 600; margin-top: 12rpx; }
.diy-btn { margin-top: 26rpx; }
