<view class="page" style="padding-top:120rpx;text-align:center">
  <view class="hero-title serif" style="font-size:44rpx">微信支付</view>
  <view class="panel" style="margin-top:40rpx;text-align:left">
    <view style="font-size:26rpx;color:var(--ink-faint)">订单号</view>
    <view style="font-size:30rpx;color:var(--ink);margin-top:6rpx">{{orderNo || '—'}}</view>
    <view style="font-size:26rpx;color:var(--ink-faint);margin-top:20rpx">应付金额</view>
    <view class="serif" style="font-size:52rpx;color:var(--gold-deep);margin-top:6rpx">¥{{amount || '—'}}</view>
  </view>
  <view class="btn btn-gold" style="margin-top:40rpx" bindtap="pay">微信支付</view>
  <view class="btn btn-ghost" style="margin-top:20rpx" bindtap="back">返回</view>
</view>
