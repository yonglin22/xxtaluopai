.bazi { padding-top: 20rpx; }
.mh { text-align: center; padding: 30rpx 0 6rpx; }
.bz-sub { font-size: 24rpx; color: var(--ink-faint); margin-top: 12rpx; }

/* 表单 */
.form { padding: 30rpx 34rpx; margin-top: 18rpx; }
.fm-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.fm-lb { font-size: 28rpx; color: var(--ink); }
.fm-val { font-size: 28rpx; color: var(--ink); }
.fm-seg { display: flex; gap: 14rpx; }
.seg { padding: 12rpx 30rpx; border-radius: 30rpx; border: 1rpx solid var(--line); color: var(--ink-soft); font-size: 26rpx; }
.seg.on { border-color: var(--amber); color: var(--gold-deep); background: rgba(201,162,78,.08); font-weight: 600; }
.fm-go { margin-top: 30rpx; }
.fm-note { font-size: 22rpx; color: var(--ink-faint); text-align: center; margin-top: 18rpx; }

.edit-bar { text-align: right; font-size: 25rpx; color: var(--gold-deep); margin-top: 20rpx; }

/* 四柱 */
.pillars { display: flex; gap: 16rpx; }
.pill { flex: 1; text-align: center; padding: 26rpx 0; border-radius: 24rpx; background: linear-gradient(180deg,#fdfaf4,#f4eddf); border: 1rpx solid rgba(180,158,112,.3); }
.pill-lb { font-size: 22rpx; color: var(--ink-faint); }
.pill-gan { font-size: 48rpx; color: var(--ink); font-weight: 700; margin-top: 10rpx; line-height: 1.2; }
.pill-zhi { font-size: 48rpx; color: var(--gold-deep); font-weight: 700; line-height: 1.2; }

/* 五行 */
.wx-panel { margin-top: 22rpx; }
.p-h { font-size: 25rpx; color: var(--gold-deep); margin-bottom: 20rpx; }
.bar-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.bar-cn { flex: none; width: 40rpx; font-family: "Songti SC", serif; font-size: 30rpx; font-weight: 700; }
.bar-track { flex: 1; height: 18rpx; border-radius: 9rpx; background: rgba(120,110,90,.12); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 9rpx; transition: width .5s; }
.bar-v { flex: none; width: 120rpx; text-align: right; font-size: 24rpx; color: var(--ink-soft); }
.tag { font-size: 18rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin-left: 6rpx; }
.tag.fav { background: rgba(111,158,120,.16); color: #4f7a5e; }
.tag.avo { background: rgba(194,74,56,.14); color: #a2311f; }
.wx-sum { font-size: 25rpx; color: var(--ink-soft); margin-top: 14rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line-soft); line-height: 1.8; }

.tz-key { font-size: 40rpx; color: var(--ink); font-weight: 700; }
.tz-xf { font-size: 25rpx; color: var(--ink-faint); margin-top: 8rpx; }

/* 珠串置顶 */
.fatetop { display: flex; align-items: center; gap: 22rpx; background: linear-gradient(135deg,#F3DFA3,#DCAE52); border: 1rpx solid rgba(201,162,78,.5); border-radius: 30rpx; padding: 26rpx 28rpx; margin-top: 24rpx; box-shadow: 0 24rpx 50rpx rgba(201,162,78,.28); }
.ft-b { flex: none; width: 76rpx; height: 76rpx; border-radius: 20rpx; background: rgba(255,255,255,.4); display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.ft-x { flex: 1; }
.ft-t { font-size: 26rpx; color: #3a2c10; font-weight: 700; line-height: 1.4; }
.ft-s { font-size: 21rpx; color: #6b551f; margin-top: 6rpx; }
.ft-a { color: #6b551f; font-size: 40rpx; }
