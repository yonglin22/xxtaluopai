<scroll-view scroll-y class="page bazi">

  <view class="mh">
    <view class="hero-eyebrow">bā zì mìng pán</view>
    <view class="hero-title serif">八字命盘</view>
    <view class="bz-sub">四柱五行 · 喜用忌神 · 中医体质</view>
  </view>

  <!-- 出生信息表单 -->
  <view wx:if="{{editing || !wx}}" class="glass form">
    <view class="fm-row">
      <text class="fm-lb">出生日期</text>
      <picker mode="date" value="{{date}}" start="1930-01-01" end="2026-12-31" bindchange="onDate">
        <view class="fm-val">{{date || '请选择'}}</view>
      </picker>
    </view>
    <view class="fm-row">
      <text class="fm-lb">出生时辰</text>
      <picker mode="selector" range="{{shichen}}" value="{{bh}}" bindchange="onShichen">
        <view class="fm-val">{{shichen[bh]}}</view>
      </picker>
    </view>
    <view class="fm-row">
      <text class="fm-lb">性别</text>
      <view class="fm-seg">
        <view class="seg {{sex==='female'?'on':''}}" data-v="female" bindtap="onSex">女</view>
        <view class="seg {{sex==='male'?'on':''}}" data-v="male" bindtap="onSex">男</view>
      </view>
    </view>
    <view class="btn btn-gold fm-go" bindtap="compute">开始排盘</view>
    <view class="fm-note">依据真节气排盘；时辰越精确，月/时柱越准。</view>
  </view>

  <block wx:if="{{wx}}">
    <view wx:if="{{!editing}}" class="edit-bar" bindtap="toggleEdit">✎ 修改出生信息</view>

    <!-- 四柱 -->
    <view class="section-h">四 柱 干 支 · 真节气排盘</view>
    <view class="pillars">
      <view wx:for="{{pillars}}" wx:key="label" class="pill">
        <view class="pill-lb">{{item.label}}</view>
        <view class="pill-gan serif">{{item.gan}}</view>
        <view class="pill-zhi serif">{{item.zhi}}</view>
      </view>
    </view>

    <!-- 五行分布 -->
    <view class="panel wx-panel">
      <view class="p-h">五行分布</view>
      <view wx:for="{{bars}}" wx:key="cn" class="bar-row">
        <view class="bar-cn" style="color:{{item.color}}">{{item.cn}}</view>
        <view class="bar-track"><view class="bar-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
        <view class="bar-v">{{item.v}}
          <text wx:if="{{item.fav}}" class="tag fav">喜</text>
          <text wx:if="{{item.avo}}" class="tag avo">忌</text>
        </view>
      </view>
      <view class="wx-sum">日主 <text class="hl serif">{{dayMasterCN}}</text>（身{{wx.shen}}） · 喜用 <text class="hl">{{favCN}}</text> · 忌 {{avoCN}}</view>
    </view>

    <!-- 中医体质 -->
    <view class="panel wx-panel">
      <view class="p-h">中医体质倾向</view>
      <view class="tz-key serif">{{tizhi.key}}</view>
      <view class="tz-xf">建议香方 · {{tizhi.xf}}</view>
    </view>

    <!-- 珠串推荐 -->
    <view class="fatetop" bindtap="goShop">
      <view class="ft-b">📿</view>
      <view class="ft-x">
        <view class="ft-t">按你的八字喜用（补{{favCN}}），为你排一串补气的珠</view>
        <view class="ft-s">命理选品 · 补喜用 · 戴在手上</view>
      </view>
      <view class="ft-a">›</view>
    </view>

    <view class="disclaimer">八字仅供自我觉察与文化参考，不构成确定性预测或医疗建议。</view>
  </block>
</scroll-view>
