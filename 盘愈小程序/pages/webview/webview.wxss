/* web-view 加载遮罩 / 错误页 —— 全用 cover-view，纯白玻璃 + 暗金 + 衬线 */
.splash {
  position: fixed; left: 0; top: 0; width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: #FFFFFF; opacity: 1; transition: opacity .42s ease;
}
.splash.fade { opacity: 0; }
.sp-eyebrow { font-size: 22rpx; letter-spacing: .34em; color: #8C6B2A; }
.sp-title {
  font-family: "Songti SC", "STSongti-SC-Regular", serif;
  font-size: 92rpx; font-weight: 700; letter-spacing: .16em; color: #1C1712; margin-top: 20rpx;
}
.sp-rule { width: 66rpx; height: 2rpx; background: #C9A24E; margin-top: 28rpx; margin-bottom: 26rpx; }
.sp-tip { font-size: 24rpx; letter-spacing: .08em; color: #5B5347; }

.errmask {
  position: fixed; left: 0; top: 0; width: 100%; height: 100%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: #FFFFFF; padding-left: 60rpx; padding-right: 60rpx;
}
.em-title { font-family: "Songti SC", serif; font-size: 46rpx; letter-spacing: .06em; color: #1C1712; }
.em-sub { font-size: 24rpx; line-height: 1.7; text-align: center; color: #5B5347; margin-top: 22rpx; }
.em-btn {
  margin-top: 44rpx; padding-top: 22rpx; padding-bottom: 22rpx; padding-left: 64rpx; padding-right: 64rpx;
  border-radius: 44rpx; background: #FFFFFF; border: 1rpx solid rgba(201,162,78,.6);
  color: #8C6B2A; font-size: 28rpx; letter-spacing: .1em;
}
