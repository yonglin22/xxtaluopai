<scroll-view scroll-y class="page ask">

  <!-- 输入态 -->
  <block wx:if="{{stage==='input'}}">
    <view class="mh">
      <view class="hero-eyebrow">ask · tarot</view>
      <view class="hero-title serif">问一事</view>
      <view class="ask-tip">写下此刻的困惑，抽三张牌，为你温柔拆解</view>
    </view>

    <view class="section-h">你想聊哪一块</view>
    <view class="dom-row">
      <view wx:for="{{domains}}" wx:key="key" class="dom {{domain===item.key?'on':''}}" data-k="{{item.key}}" bindtap="pickDomain">
        <view class="dom-c serif">{{item.key}}</view>
        <view class="dom-en">{{item.en}}</view>
      </view>
    </view>

    <view class="glass ask-box">
      <textarea class="ask-ta" placeholder="比如：要不要接受那个 offer？和 TA 还有没有可能……" maxlength="300"
                value="{{text}}" bindinput="onInput" auto-height />
    </view>

    <view class="btn btn-gold ask-go" bindtap="runReading">✦ 抽牌解读</view>
    <view class="disclaimer">这是一面镜子，照见此刻、不是判决；怎么走，始终由你说了算。</view>
  </block>

  <!-- 加载态 -->
  <view wx:elif="{{stage==='loading'}}" class="loading">
    <view class="load-orb">◔</view>
    <view class="load-tx serif">正在为你抽牌…</view>
    <view class="load-sub">{{domain}} · 三张牌正在落定</view>
  </view>

  <!-- 结果态 -->
  <block wx:elif="{{stage==='result'}}">
    <!-- 珠串推荐（置顶显眼） -->
    <view class="fatetop" bindtap="goShop">
      <view class="ft-b">📿</view>
      <view class="ft-x">
        <view class="ft-t">顺着这次牌意，为你排一串把方向戴在手上的珠</view>
        <view class="ft-s">命理选品 · 顺牌意为你而选 · 戴在手上</view>
      </view>
      <view class="ft-a">›</view>
    </view>

    <!-- 三张牌 -->
    <view class="cards">
      <view wx:for="{{cards}}" wx:key="name" class="card {{item.reversed?'rev':''}}">
        <view class="card-nm serif">{{item.name}}</view>
        <view class="card-pos">{{item.position}} · {{item.reversed?'逆位':'正位'}}</view>
      </view>
    </view>

    <view class="rd-sec">
      <view class="rd-label">牌面在说</view>
      <view class="rd-persp">{{result.perspective}}</view>
    </view>

    <view class="rd-sec">
      <view class="rd-label">今天 · 先做这一件</view>
      <view class="rd-action glass">{{result.action}}</view>
    </view>

    <view class="rd-more" bindtap="toggleMore">
      <text>展开更多 · 你的处境与选择方向</text>
      <text class="chev {{showMore?'open':''}}">▾</text>
    </view>
    <view wx:if="{{showMore}}" class="rd-more-body">
      <view wx:if="{{result.situation}}" class="rd-sec">
        <view class="rd-label">此刻的你</view>
        <view class="rd-persp">{{result.situation}}</view>
      </view>
      <view wx:if="{{result.insights.length}}" class="rd-sec">
        <view class="rd-label">你可以怎么选</view>
        <view wx:for="{{result.insights}}" wx:key="*this" class="ins">
          <view class="ins-n">{{index+1}}</view>
          <view class="ins-t">{{item}}</view>
        </view>
      </view>
    </view>

    <view class="wx-line">想把这件事聊透？<text class="hl">加微信 1 对 1 解读 →</text></view>
    <view class="disclaimer">这是一面镜子，照见此刻、不是判决；怎么走，始终由你说了算。</view>
    <view class="rd-fab-spacer"></view>

    <!-- 悬浮按钮 -->
    <view class="rd-fab">
      <view class="btn btn-ghost fab-b" bindtap="collect">收藏</view>
      <view class="btn btn-gold fab-b" bindtap="askAgain">再问一事</view>
    </view>
  </block>

</scroll-view>
