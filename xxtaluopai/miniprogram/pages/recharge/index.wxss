.recharge { padding-top: 44rpx; padding-bottom: 60rpx; }

.rc-balance { text-align: center; margin-bottom: 60rpx; }
.rc-cap { font-size: 24rpx; margin-bottom: 12rpx; }
.rc-num { font-size: 68rpx; line-height: 1; }

.pack { display: flex; align-items: center; justify-content: space-between; background: var(--bg-raise); border: 1rpx solid var(--line); border-radius: 26rpx; padding: 38rpx 42rpx; margin-bottom: 24rpx; }
.pack-hover { background: #F1EEE8; }
.pk-credits { font-size: 38rpx; }
.pk-label { font-size: 24rpx; margin-top: 12rpx; }
.pk-price { font-size: 42rpx; }

/* ---- 下单后：收款码 + 订单号 + 客服 ---- */
.order-panel { background: var(--bg-raise); border: 1rpx solid var(--line); border-radius: 28rpx; padding: 40rpx 36rpx; }
.op-title { font-size: 30rpx; text-align: center; margin-bottom: 30rpx; }
.op-qr { display: flex; justify-content: center; margin-bottom: 30rpx; }
.qr-img { width: 380rpx; height: 380rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #fff; }
.qr-ph { width: 380rpx; height: 380rpx; border: 1rpx dashed var(--line); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 22rpx; padding: 30rpx; line-height: 1.6; }

.op-steps { font-size: 27rpx; line-height: 1.9; color: var(--ink-soft); }
.step { margin: 6rpx 0; }
.sn { color: var(--ink); font-family: var(--serif); margin-right: 6rpx; }
.hl { color: var(--amber); }
.op-field { margin: 14rpx 0 6rpx; font-size: 25rpx; color: var(--ink-faint); }
.code { color: var(--ink); font-size: 28rpx; background: var(--bg); padding: 6rpx 14rpx; border-radius: 8rpx; border: 1rpx solid var(--line); letter-spacing: .04em; }
.op-btns { display: flex; gap: 18rpx; margin: 20rpx 0; }
.btn.mini { padding: 16rpx 28rpx; font-size: 24rpx; }
.cs-wx { font-size: 26rpx; color: var(--amber); margin-bottom: 14rpx; }

.op-waiting { font-size: 23rpx; line-height: 1.7; margin: 28rpx 0 22rpx; text-align: center; }
